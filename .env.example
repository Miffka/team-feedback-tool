# Copy to .env and adjust. docker compose reads this file automatically.

DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=feedback
POSTGRES_USER=feedback
POSTGRES_PASSWORD=feedback
# Inside docker compose the host is the service name; use localhost from the host.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
